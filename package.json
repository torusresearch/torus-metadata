{
  "name": "torus-metadata",
  "version": "1.0.0",
  "private": true,
  "description": "Torus metadata server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "down": "docker compose -f docker-compose.dev.yml down",
    "serve": "vpx --watch --env-file=.env.development src/index.ts",
    "build": "rimraf ./dist && tsc",
    "start": "vpx src/index.ts",
    "prod": "node dist/index.js",
    "migrate": "npm run migrate:down && npm run migrate:latest",
    "migrate:latest": "NODE_OPTIONS='--import vite-plus/register' knex migrate:latest --knexfile ./src/database/knexfile.ts",
    "migrate:down": "NODE_OPTIONS='--import vite-plus/register' knex migrate:down --knexfile ./src/database/knexfile.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "harden:check": "harden check -p npm -l moderate",
    "prepare": "husky",
    "test": "vp test run --config=test/node.config.mts",
    "test:ci": "docker compose -f docker-compose-ci.yml up --build --abort-on-container-exit --exit-code-from torus-metadata",
    "down:ci": "docker compose -f docker-compose-ci.yml down",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "keywords": [],
  "author": "Chaitanya Potti",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^11.16.0",
    "@sesamecare-oss/redlock": "^1.4.0",
    "@toruslabs/eccrypto": "^8.0.0",
    "@toruslabs/loglevel-sentry": "^10.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "celebrate": "^16.0.0",
    "cids": "^1.1.9",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "json-stable-stringify": "^1.3.0",
    "knex": "^3.3.0",
    "knex-on-duplicate-update": "^2.3.3",
    "loglevel": "^1.9.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "multihashing-async": "^2.1.4",
    "mysql2": "3.24.6",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "0.9.0",
    "@tkey/common-types": "^17.2.0",
    "@tkey/storage-layer-torus": "^17.2.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-node": "^1.0.0",
    "@toruslabs/torus-scripts": "^9.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "elliptic": "^6.6.1",
    "husky": "^9.1.7",
    "js-sha3": "^0.14.0",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite-plus": "1.7.0",
    "wait-port": "^1.1.0"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "vp lint --fix",
      "vp fmt"
    ],
    "*.{json,yaml,yml}": [
      "vp fmt"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/torus-metadata.git"
  },
  "bugs": {
    "url": "https://github.com/torusresearch/torus-metadata/issues"
  },
  "homepage": "https://github.com/torusresearch/torus-metadata#readme",
  "engines": {
    "node": ">=24.22.3 <25 || >=26.13.1",
    "npm": ">=12"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
